{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heatmap.local/schemas/event-v1.json",
  "title": "Heatmap Event V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "session_id",
    "anonymous_id",
    "timestamp",
    "sdk",
    "platform",
    "event"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "anonymous_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "number"
    },
    "window_id": {
      "type": "string",
      "minLength": 1
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "os_version", "app_version"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["web", "ios", "android", "macos", "windows"]
        },
        "os_version": { "type": "string", "minLength": 1 },
        "app_version": { "type": "string", "minLength": 1 }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layout_version": { "type": "string", "minLength": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session_start",
            "session_end",
            "screen_view",
            "click",
            "scroll"
          ]
        },
        "element_id": { "type": "string", "minLength": 1 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
