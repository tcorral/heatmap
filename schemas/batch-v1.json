{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heatmap.local/schemas/batch-v1.json",
  "title": "Heatmap Batch V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "events"],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "event-v1.json"
      }
    }
  }
}
