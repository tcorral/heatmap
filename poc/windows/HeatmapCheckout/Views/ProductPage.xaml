<Page x:Class="HeatmapCheckout.Views.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:HeatmapCheckout;assembly=HeatmapCheckout.Contract"
      Title="Product">
    <StackPanel Margin="16" VerticalAlignment="Top">
        <TextBlock Text="Product" FontSize="32" Margin="0,0,0,16" />
        <TextBlock Text="Activate a plan to continue to checkout." Margin="0,0,0,16" />
        <Button Content="Activate product"
                Click="OnActivateProduct"
                AutomationProperties.AutomationId="{x:Static local:CheckoutIdentifiers.ProductActivate}"
                Padding="12,6"
                HorizontalAlignment="Left" />
    </StackPanel>
</Page>
