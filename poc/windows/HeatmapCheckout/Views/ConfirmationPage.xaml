<Page x:Class="HeatmapCheckout.Views.ConfirmationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Confirmation">
    <StackPanel Margin="16" VerticalAlignment="Top">
        <TextBlock Text="Confirmation" FontSize="32" Margin="0,0,0,16" />
        <TextBlock Text="Payment submitted. Your order is confirmed." Margin="0,0,0,16" />
        <Button Content="Back to home"
                Click="OnBackToHome"
                Padding="12,6"
                HorizontalAlignment="Left" />
    </StackPanel>
</Page>
